<?php

class Student
{
    private int $id;
    private string $name;
    private int $age;
    private string $course;

    public function __construct(int $id, string $name, int $age, string $course)
    {
        $this->id = $id;
        $this->name = $name;
        $this->age = $age;
        $this->course = $course;
    }

    public function getId(): int
    {
        return $this->id;
    }

    public function display(): void
    {
        echo "ID: " . $this->id . PHP_EOL;
        echo "Name: " . $this->name . PHP_EOL;
        echo "Age: " . $this->age . PHP_EOL;
        echo "Course: " . $this->course . PHP_EOL;
    }
}

class StudentManager
{
    private array $students = [];

    public function addStudent(Student $student): void
    {
        $this->students[] = $student;
        echo "Student added successfully!" . PHP_EOL;
    }

    public function viewStudents(): void
    {
        if (empty($this->students)) {
            echo "No students found." . PHP_EOL;
            return;
        }

        echo PHP_EOL . "----- All Students -----" . PHP_EOL;

        foreach ($this->students as $student) {
            $student->display();
            echo "------------------------" . PHP_EOL;
        }
    }

    public function findStudent(int $id): void
    {
        foreach ($this->students as $student) {
            if ($student->getId() === $id) {
                echo PHP_EOL . "----- Student Found -----" . PHP_EOL;
                $student->display();
                return;
            }
        }

        echo "Student not found." . PHP_EOL;
    }

    public function deleteStudent(int $id): void
    {
        foreach ($this->students as $key => $student) {
            if ($student->getId() === $id) {
                unset($this->students[$key]);
                echo "Student deleted successfully!" . PHP_EOL;
                return;
            }
        }

        echo "Student not found." . PHP_EOL;
    }
}

$manager = new StudentManager();

while (true) {

    echo PHP_EOL;
    echo "============================" . PHP_EOL;
    echo "   STUDENT MANAGEMENT CLI" . PHP_EOL;
    echo "============================" . PHP_EOL;
    echo "1. Add Student" . PHP_EOL;
    echo "2. View All Students" . PHP_EOL;
    echo "3. Find Student" . PHP_EOL;
    echo "4. Delete Student" . PHP_EOL;
    echo "5. Exit" . PHP_EOL;
    echo "============================" . PHP_EOL;

    $choice = (int) readline("Enter your choice: ");

    switch ($choice) {

        case 1:
            $id = (int) readline("Enter student ID: ");
            $name = readline("Enter student name: ");
            $age = (int) readline("Enter student age: ");
            $course = readline("Enter student course: ");

            $student = new Student($id, $name, $age, $course);

            $manager->addStudent($student);
            break;

        case 2:
            $manager->viewStudents();
            break;

        case 3:
            $id = (int) readline("Enter student ID to find: ");
            $manager->findStudent($id);
            break;

        case 4:
            $id = (int) readline("Enter student ID to delete: ");
            $manager->deleteStudent($id);
            break;

        case 5:
            echo "Thank you for using Student Management CLI!" . PHP_EOL;
            exit;

        default:
            echo "Invalid choice. Please try again." . PHP_EOL;
    }
}
